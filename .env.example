# ================================================
# NAVYA COLLECTION - PRODUCTION ENVIRONMENT CONFIG
# ================================================

# Database Connection Strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Application Settings
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"

# Authentication & JWT Secrets (Required in Production)
JWT_SECRET="your_custom_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Admin Initial Seed Credentials
ADMIN_INITIAL_EMAIL="admin@navyacollection.com"
ADMIN_INITIAL_PASSWORD="YourSecureAdminPassword123!"

# MSG91 SMS Gateway Configuration
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_template_id"
MSG91_SENDER_ID="NAVYAC"
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=1

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Shiprocket Logistics Integration
SHIPROCKET_EMAIL="logistics@navyacollection.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
