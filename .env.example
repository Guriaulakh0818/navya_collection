# ==============================================================================
# NAVYA COLLECTION - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or production credentials to version control.

# ==============================================================================
# 1. DATABASE ENVIRONMENT & ISOLATION CONFIGURATION
# ==============================================================================
# DATABASE_ENV options: 'local' (development/testing) | 'production' (live deployment)
# Local developers MUST use DATABASE_ENV="local" pointing to an isolated local PostgreSQL database.
DATABASE_ENV="local"
NODE_ENV="development"

# LOCAL DATABASE URL (Example: Local PostgreSQL instance / container)
# Must NEVER point to the live production database host from local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navya_collection_local"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/navya_collection_local"

# PRODUCTION DEPLOYMENT SETTING (Configured via Vercel / Cloud Dashboard only):
# DATABASE_ENV="production"
# NODE_ENV="production"
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[DIRECT_HOST]:5432/postgres"

# ==============================================================================
# 2. APPLICATION & AUTH SETTINGS
# ==============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_custom_nextauth_secret_key_minimum_32_characters"
JWT_SECRET="your_custom_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Admin Initial Seed Credentials (Local only)
ADMIN_INITIAL_EMAIL="admin@navyacollection.com"
ADMIN_INITIAL_PASSWORD="YourSecureAdminPassword123!"

# ==============================================================================
# 3. BREVO (SENDINBLUE) EMAIL & OTP CONFIGURATION
# ==============================================================================
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="support@navyacollection.in"
BREVO_SENDER_NAME="Navya Collection"
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3

# ==============================================================================
# 4. RAZORPAY PAYMENT GATEWAY (TEST KEYS FOR LOCAL)
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"

# ==============================================================================
# 5. CLOUDINARY MEDIA STORAGE
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# 6. SHIPROCKET LOGISTICS INTEGRATION
# ==============================================================================
SHIPROCKET_EMAIL="logistics@navyacollection.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
