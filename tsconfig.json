{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@/frontend/*": ["./src/frontend/*"],
      "@/backend/*": ["./src/backend/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/components": ["./src/frontend/components"],
      "@/components/*": ["./src/frontend/components/*"],
      "@/features": ["./src/frontend/features"],
      "@/features/*": ["./src/frontend/features/*"],
      "@/hooks": ["./src/frontend/hooks"],
      "@/hooks/*": ["./src/frontend/hooks/*"],
      "@/providers": ["./src/frontend/providers"],
      "@/providers/*": ["./src/frontend/providers/*"],
      "@/stores": ["./src/frontend/stores"],
      "@/stores/*": ["./src/frontend/stores/*"],
      "@/styles": ["./src/frontend/styles"],
      "@/styles/*": ["./src/frontend/styles/*"],
      "@/assets": ["./src/frontend/assets"],
      "@/assets/*": ["./src/frontend/assets/*"],
      "@/services": ["./src/backend/services"],
      "@/services/*": ["./src/backend/services/*"],
      "@/lib": ["./src/backend/lib"],
      "@/lib/*": ["./src/backend/lib/*"],
      "@/actions": ["./src/backend/actions"],
      "@/actions/*": ["./src/backend/actions/*"],
      "@/middleware": ["./src/backend/middleware"],
      "@/middleware/*": ["./src/backend/middleware/*"],
      "@/schemas": ["./src/backend/schemas"],
      "@/schemas/*": ["./src/backend/schemas/*"],
      "@/validations": ["./src/backend/validations"],
      "@/validations/*": ["./src/backend/validations/*"],
      "@/types": ["./src/shared/types"],
      "@/types/*": ["./src/shared/types/*"],
      "@/config": ["./src/shared/config"],
      "@/config/*": ["./src/shared/config/*"],
      "@/constants": ["./src/shared/constants"],
      "@/constants/*": ["./src/shared/constants/*"],
      "@/utils": ["./src/shared/utils"],
      "@/utils/*": ["./src/shared/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
